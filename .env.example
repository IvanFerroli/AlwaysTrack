# Shared local demo configuration. Safe for fake users and local-only providers.
# Real provider credentials belong in a private environment, never in this file.
NODE_ENV="development"
APP_MODE="local"
APP_NAME="AlwaysTrack"

# Local services
DATABASE_URL="file:./dev.db"
SESSION_SECRET="alwaystrack-local-demo-session-secret-not-for-production"
SESSION_COOKIE_NAME="alwaystrack_session"
API_PORT="3333"
WEB_PORT="5173"
WORKBENCH_PORT="4173"
STUDIO_PORT="5555"
CORS_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL=""
VITE_APP_NAME="AlwaysTrack"
VITE_DEMO_MODE="false"

# Deterministic fake users used by the local seed
SEED_ORGANIZATION_ID="alwaystrack-local"
SEED_ORGANIZATION_NAME="AlwaysTrack Local"
SEED_ADMIN_PASSWORD="AlwaysTrackDev123!"
SEED_SAC_PASSWORD="AlwaysTrackDev123!"
SEED_FINANCEIRO_PASSWORD="AlwaysTrackDev123!"
SEED_SELLER_PASSWORD="AlwaysTrackDev123!"
SEED_SUPERVISOR_PASSWORD="AlwaysTrackDev123!"

# Local-only providers
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage/private"
DOCUMENT_MAX_BYTES="10485760"
NOTIFICATION_PROVIDER="fake"
DOCUMENT_AI_PROVIDER="fake"
JOB_QUEUE_DRIVER="inline"
ENABLE_LEGACY_SYLEMBRA="false"
ENABLE_LEGACY_SALES_WRITES="false"
