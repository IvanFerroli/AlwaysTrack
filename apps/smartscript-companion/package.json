{
  "name": "@alwaystrack/smartscript-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "smartscript": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "tsx src/cli.ts status"
  },
  "dependencies": {
    "@alwaystrack/shared": "file:../../packages/shared"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
