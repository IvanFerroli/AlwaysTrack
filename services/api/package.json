{
  "name": "@alwaystrack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:html": "vitest run --coverage",
    "test:jobs:redis": "RUN_REDIS_JOBS_TESTS=true JOB_QUEUE_DRIVER=bullmq vitest run queue.redis.test.ts",
    "job:notifications": "tsx src/jobs/notifications.ts",
    "job:announcement-scheduler": "tsx src/jobs/announcement-scheduler.ts",
    "job:support-schedule-horizon": "tsx src/jobs/support-schedule-horizon.ts",
    "job:ranking-snapshots": "tsx src/jobs/ranking-snapshots.ts",
    "smoke:whatsapp": "tsx src/scripts/smoke-whatsapp.ts",
    "smoke:google-sheets": "tsx src/scripts/smoke-google-sheets.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@alwaystrack/shared": "file:../../packages/shared",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.78.0",
    "cookie": "^2.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.20.6",
    "vitest": "^3.2.6"
  }
}
