generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  document     String?
  logoUrl      String?
  settingsJson String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                         User[]
  units                         Unit[]
  licenseTypes                  LicenseType[]
  notificationTemplates         NotificationTemplate[]
  notificationRules             NotificationRule[]
  notificationJobs              NotificationJob[]
  inAppNotifications            InAppNotification[]
  announcements                 Announcement[]
  announcementSeries            AnnouncementSeries[]
  announcementSeriesVersions    AnnouncementSeriesVersion[]
  announcementOccurrences       AnnouncementOccurrence[]
  announcementReadReceipts      AnnouncementReadReceipt[]
  scriptCategories              ScriptCategory[]
  scriptPacks                   ScriptPack[]
  scriptPackItems               ScriptPackItem[]
  operationalScripts            OperationalScript[]
  serviceFlows                  ServiceFlow[]
  serviceFlowSteps              ServiceFlowStep[]
  serviceFlowVersions           ServiceFlowVersion[]
  serviceFlowNodes              ServiceFlowNode[]
  serviceFlowTransitions        ServiceFlowTransition[]
  serviceFlowStepScripts        ServiceFlowStepScript[]
  serviceFlowSessions           ServiceFlowSession[]
  serviceFlowSessionSteps       ServiceFlowSessionStep[]
  serviceFlowRevisions          ServiceFlowRevision[]
  serviceFlowSearchEvents       ServiceFlowSearchEvent[]
  personalScripts               PersonalScript[]
  personalScriptFlows           PersonalScriptFlow[]
  smartScriptBatches            SmartScriptBatch[]
  smartScriptDecisionLogs       SmartScriptDecisionLog[]
  smartScriptExports            SmartScriptExport[]
  operationalScriptRevisions    OperationalScriptRevision[]
  operationalScriptEvents       OperationalScriptEvent[]
  operationalScriptSuggestions  OperationalScriptSuggestion[]
  operationalScriptSearchEvents OperationalScriptSearchEvent[]
  faqItems                      FaqItem[]
  faqThreads                    FaqThread[]
  faqComments                   FaqComment[]
  faqReactions                  FaqReaction[]
  wikiPages                     WikiPage[]
  wikiEditRequests              WikiEditRequest[]
  wikiReadReceipts              WikiReadReceipt[]
  wikiPresences                 WikiPresence[]
  wikiRevisions                 WikiRevision[]
  wikiAttachments               WikiAttachment[]
  operationalAttachments        OperationalAttachment[]
  professionals                 Professional[]
  auditLogs                     AuditLog[]
  documentAiExtractions         DocumentAiExtraction[]
  googleConnections             GoogleConnection[]
  googleOauthStates             GoogleOauthState[]
  sellerProfiles                SellerProfile[]
  salesGroups                   SalesGroup[]
  salesDocuments                SalesDocument[]
  salesCampaigns                SalesCampaign[]
  rankingSnapshots              RankingSnapshot[]
  supportPausePolicy            SupportPausePolicy?
  supportTeams                  SupportTeam[]
  supportTeamMemberships        SupportTeamMembership[]
  supportPauseSlots             SupportPauseSlot[]
  supportPauseBookings          SupportPauseBooking[]
  supportPauseSwaps             SupportPauseSwap[]
  supportScheduleRuleVersions   SupportScheduleRuleVersion[]
  supportShiftPatternVersions   SupportShiftPatternVersion[]
  supportShiftAssignments       SupportShiftAssignment[]
  supportShiftOccurrences       SupportShiftOccurrence[]
  supportShiftOffers            SupportShiftOffer[]
  supportExtraShiftSlots        SupportExtraShiftSlot[]
  supportExtraShiftClaims       SupportExtraShiftClaim[]
  supportKpiEntries             SupportKpiEntry[]
  supportCampaigns              SupportCampaign[]
  serviceCases                  ServiceCase[]
  companionInstallations        CompanionInstallation[]
  connectorDefinitions          ConnectorDefinition[]
  connectorHealthEvents         ConnectorHealthEvent[]
  serviceCaseSources            ServiceCaseSource[]
  connectorRuns                 ConnectorRun[]
  evidenceFacts                 EvidenceFact[]
  evidenceConflicts             EvidenceConflict[]
}

model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sectors       Sector[]
  professionals Professional[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([active])
}

model Sector {
  id        String   @id @default(cuid())
  unitId    String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit          Unit           @relation(fields: [unitId], references: [id])
  professionals Professional[]

  @@unique([unitId, name])
  @@index([unitId])
  @@index([active])
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              String
  phone             String?
  avatarUrl         String?
  active            Boolean  @default(true)
  passwordChangedAt DateTime @default(now())
  organizationId    String
  unitScopeJson     String?
  sectorScopeJson   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization                         Organization                   @relation(fields: [organizationId], references: [id])
  auditLogs                            AuditLog[]
  professionalsAsRt                    Professional[]                 @relation("ProfessionalResponsibleRt")
  professionalAccount                  Professional?                  @relation("ProfessionalUser")
  validatedLicenses                    License[]                      @relation("LicenseValidatedBy")
  uploadedDocuments                    Document[]                     @relation("DocumentUploadedByUser")
  validatedDocuments                   Document[]                     @relation("DocumentValidatedBy")
  appliedExtractions                   DocumentAiExtraction[]         @relation("DocumentAiExtractionAppliedBy")
  googleConnection                     GoogleConnection?
  googleOauthStates                    GoogleOauthState[]
  wikiPagesCreated                     WikiPage[]                     @relation("WikiPageCreatedBy")
  wikiPagesUpdated                     WikiPage[]                     @relation("WikiPageUpdatedBy")
  wikiEditRequestsAuthored             WikiEditRequest[]              @relation("WikiEditRequestAuthor")
  wikiEditRequestsReviewed             WikiEditRequest[]              @relation("WikiEditRequestReviewer")
  wikiReadReceipts                     WikiReadReceipt[]              @relation("WikiReadReceiptUser")
  wikiPresences                        WikiPresence[]                 @relation("WikiPresenceUser")
  wikiRevisions                        WikiRevision[]                 @relation("WikiRevisionAuthor")
  wikiAttachments                      WikiAttachment[]               @relation("WikiAttachmentUploader")
  operationalAttachmentsUploaded       OperationalAttachment[]        @relation("OperationalAttachmentUploader")
  operationalAttachmentsArchived       OperationalAttachment[]        @relation("OperationalAttachmentArchiver")
  sellerProfile                        SellerProfile?                 @relation("SellerProfileUser")
  supervisedSalesGroups                SalesGroup[]                   @relation("SalesGroupSupervisor")
  uploadedSalesDocuments               SalesDocument[]                @relation("SalesDocumentUploadedBy")
  reviewedSalesDocuments               SalesDocument[]                @relation("SalesDocumentReviewedBy")
  faqThreadsAuthored                   FaqThread[]                    @relation("FaqThreadAuthor")
  faqThreadsPromoted                   FaqThread[]                    @relation("FaqThreadPromoter")
  faqCommentsAuthored                  FaqComment[]                   @relation("FaqCommentAuthor")
  faqReactionsAuthored                 FaqReaction[]                  @relation("FaqReactionUser")
  inAppNotifications                   InAppNotification[]            @relation("InAppNotificationRecipient")
  announcementsAuthored                Announcement[]                 @relation("AnnouncementAuthor")
  announcementsUpdated                 Announcement[]                 @relation("AnnouncementUpdatedBy")
  announcementSeriesCreated            AnnouncementSeries[]           @relation("AnnouncementSeriesCreator")
  announcementSeriesUpdated            AnnouncementSeries[]           @relation("AnnouncementSeriesUpdater")
  announcementSeriesVersionsCreated    AnnouncementSeriesVersion[]    @relation("AnnouncementSeriesVersionCreator")
  announcementOccurrencesCancelled     AnnouncementOccurrence[]       @relation("AnnouncementOccurrenceCanceller")
  announcementReadReceipts             AnnouncementReadReceipt[]      @relation("AnnouncementReadReceiptUser")
  scriptCategoriesCreated              ScriptCategory[]               @relation("ScriptCategoryCreatedBy")
  scriptPacksCreated                   ScriptPack[]                   @relation("ScriptPackCreatedBy")
  scriptPacksUpdated                   ScriptPack[]                   @relation("ScriptPackUpdatedBy")
  operationalScriptsCreated            OperationalScript[]            @relation("OperationalScriptCreatedBy")
  operationalScriptsUpdated            OperationalScript[]            @relation("OperationalScriptUpdatedBy")
  operationalScriptsValidated          OperationalScript[]            @relation("OperationalScriptValidatedBy")
  operationalScriptsRecertified        OperationalScript[]            @relation("OperationalScriptRecertifiedBy")
  serviceFlowsCreated                  ServiceFlow[]                  @relation("ServiceFlowCreatedBy")
  serviceFlowsUpdated                  ServiceFlow[]                  @relation("ServiceFlowUpdatedBy")
  serviceFlowsReviewed                 ServiceFlow[]                  @relation("ServiceFlowReviewedBy")
  serviceFlowVersionsPublished         ServiceFlowVersion[]           @relation("ServiceFlowVersionPublishedBy")
  serviceFlowRevisionsAuthored         ServiceFlowRevision[]          @relation("ServiceFlowRevisionAuthor")
  serviceFlowSearchEvents              ServiceFlowSearchEvent[]       @relation("ServiceFlowSearchEventUser")
  serviceFlowSessions                  ServiceFlowSession[]           @relation("ServiceFlowSessionUser")
  personalScripts                      PersonalScript[]               @relation("PersonalScriptOwner")
  smartScriptBatches                   SmartScriptBatch[]             @relation("SmartScriptBatchOwner")
  smartScriptOwnedDecisionLogs         SmartScriptDecisionLog[]       @relation("SmartScriptDecisionOwner")
  smartScriptDecisionLogs              SmartScriptDecisionLog[]       @relation("SmartScriptDecisionActor")
  smartScriptOwnedExports              SmartScriptExport[]            @relation("SmartScriptExportOwner")
  smartScriptExports                   SmartScriptExport[]            @relation("SmartScriptExportActor")
  operationalScriptRevisionsAuthored   OperationalScriptRevision[]    @relation("OperationalScriptRevisionAuthor")
  operationalScriptEvents              OperationalScriptEvent[]       @relation("OperationalScriptEventUser")
  operationalScriptSuggestionsAuthored OperationalScriptSuggestion[]  @relation("OperationalScriptSuggestionAuthor")
  operationalScriptSuggestionsDecided  OperationalScriptSuggestion[]  @relation("OperationalScriptSuggestionDecider")
  operationalScriptSearchEvents        OperationalScriptSearchEvent[] @relation("OperationalScriptSearchEventUser")
  serviceCasesCreated                  ServiceCase[]                  @relation("ServiceCaseCreatedBy")
  companionInstallations               CompanionInstallation[]        @relation("CompanionInstallationUser")
  connectorRuns                        ConnectorRun[]                 @relation("ConnectorRunUser")
  evidenceConflictsResolved            EvidenceConflict[]             @relation("EvidenceConflictResolvedBy")
  supportPauseSlotsCreated             SupportPauseSlot[]             @relation("SupportPauseSlotCreator")
  supportPauseBookings                 SupportPauseBooking[]
  supportPauseSwapsRequested           SupportPauseSwap[]             @relation("SupportPauseSwapRequester")
  supportPauseSwapsDecided             SupportPauseSwap[]             @relation("SupportPauseSwapDecider")
  supportKpiEntriesTargeted            SupportKpiEntry[]              @relation("SupportKpiTarget")
  supportKpiEntriesCreated             SupportKpiEntry[]              @relation("SupportKpiCreator")
  supportKpiEntriesUpdated             SupportKpiEntry[]              @relation("SupportKpiUpdater")
  supportCampaignsTargeted             SupportCampaign[]              @relation("SupportCampaignTarget")
  supportCampaignsCreated              SupportCampaign[]              @relation("SupportCampaignCreator")
  supportCampaignsUpdated              SupportCampaign[]              @relation("SupportCampaignUpdater")
  supportTeamMemberships               SupportTeamMembership[]
  supportScheduleRulesCreated          SupportScheduleRuleVersion[]   @relation("SupportScheduleRuleCreator")
  supportShiftPatternsCreated          SupportShiftPatternVersion[]   @relation("SupportShiftPatternCreator")
  supportShiftAssignments              SupportShiftAssignment[]       @relation("SupportShiftAssignmentUser")
  supportShiftAssignmentsCreated       SupportShiftAssignment[]       @relation("SupportShiftAssignmentCreator")
  supportShiftAssignmentsUpdated       SupportShiftAssignment[]       @relation("SupportShiftAssignmentUpdater")
  supportShiftOccurrences              SupportShiftOccurrence[]       @relation("SupportShiftOccurrenceUser")
  supportShiftOccurrencesCreated       SupportShiftOccurrence[]       @relation("SupportShiftOccurrenceCreator")
  supportShiftOccurrencesUpdated       SupportShiftOccurrence[]       @relation("SupportShiftOccurrenceUpdater")
  supportShiftOffersCreated            SupportShiftOffer[]            @relation("SupportShiftOfferCreator")
  supportShiftOffersTargeted           SupportShiftOffer[]            @relation("SupportShiftOfferTargetUser")
  supportShiftOffersDecided            SupportShiftOffer[]            @relation("SupportShiftOfferDecider")
  supportExtraShiftSlotsCreated        SupportExtraShiftSlot[]        @relation("SupportExtraShiftSlotCreator")
  supportExtraShiftClaims              SupportExtraShiftClaim[]       @relation("SupportExtraShiftClaimUser")
  supportExtraShiftClaimsDecided       SupportExtraShiftClaim[]       @relation("SupportExtraShiftClaimDecider")

  @@index([organizationId])
  @@index([role])
  @@index([active])
}

model SellerProfile {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String?  @unique
  salesGroupId     String?
  code             String
  displayName      String
  document         String?
  email            String?
  phone            String?
  active           Boolean  @default(true)
  monthlyGoalCents Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  user         User?           @relation("SellerProfileUser", fields: [userId], references: [id])
  salesGroup   SalesGroup?     @relation(fields: [salesGroupId], references: [id])
  documents    SalesDocument[]
  items        SalesItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([salesGroupId])
  @@index([active])
}

model SalesGroup {
  id             String   @id @default(cuid())
  organizationId String
  supervisorId   String?
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  supervisor   User?           @relation("SalesGroupSupervisor", fields: [supervisorId], references: [id])
  sellers      SellerProfile[]
  campaigns    SalesCampaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([supervisorId])
  @@index([active])
}

model SalesDocument {
  id                   String    @id @default(cuid())
  organizationId       String
  sellerProfileId      String
  uploadedById         String
  reviewedById         String?
  fileKey              String
  fileName             String
  mimeType             String
  size                 Int
  status               String    @default("UPLOADED")
  accessKey            String?
  invoiceNumber        String?
  series               String?
  issuedAt             DateTime?
  issuerName           String?
  buyerName            String?
  totalAmountCents     Int?
  extractionConfidence Float?
  rejectionReason      String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id])
  sellerProfile SellerProfile             @relation(fields: [sellerProfileId], references: [id])
  uploadedBy    User                      @relation("SalesDocumentUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy    User?                     @relation("SalesDocumentReviewedBy", fields: [reviewedById], references: [id])
  extractions   SalesDocumentExtraction[]
  items         SalesItem[]

  @@unique([organizationId, accessKey])
  @@index([organizationId])
  @@index([sellerProfileId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([status])
  @@index([issuedAt])
}

model SalesDocumentExtraction {
  id              String   @id @default(cuid())
  salesDocumentId String
  provider        String
  rawText         String?
  extractedJson   String
  confidence      Float?
  createdAt       DateTime @default(now())

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id])

  @@index([salesDocumentId])
  @@index([provider])
}

model SalesItem {
  id               String   @id @default(cuid())
  salesDocumentId  String
  sellerProfileId  String
  sku              String?
  description      String
  category         String?
  quantity         Float
  unitAmountCents  Int?
  totalAmountCents Int
  createdAt        DateTime @default(now())

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id])
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id])

  @@index([salesDocumentId])
  @@index([sellerProfileId])
  @@index([sku])
  @@index([category])
}

model SalesCampaign {
  id             String   @id @default(cuid())
  organizationId String
  salesGroupId   String?
  name           String
  description    String?
  metric         String
  status         String   @default("DRAFT")
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  salesGroup       SalesGroup?       @relation(fields: [salesGroupId], references: [id])
  rankingSnapshots RankingSnapshot[]

  @@index([organizationId])
  @@index([salesGroupId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model RankingSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String?
  periodStart    DateTime
  periodEnd      DateTime
  scopeType      String
  scopeId        String?
  payloadJson    String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  campaign     SalesCampaign? @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([campaignId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([scopeType])
}

model SupportPausePolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  timezone              String   @default("America/Sao_Paulo")
  minimumCoverage       Int      @default(2)
  slotMinutes           Int      @default(15)
  pauseDurationMinutes  Int      @default(75)
  boundaryBufferMinutes Int      @default(15)
  shiftWindowsJson      String   @default("[{\"start\":\"08:00\",\"end\":\"14:45\"},{\"start\":\"15:00\",\"end\":\"22:00\"}]")
  templateStartsJson    String   @default("[\"09:45\",\"10:30\",\"10:45\",\"11:15\",\"11:30\",\"11:45\",\"12:15\",\"13:00\",\"15:15\",\"17:15\",\"17:45\",\"18:15\",\"19:15\",\"19:45\",\"20:15\"]")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model SupportTeam {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization                 @relation(fields: [organizationId], references: [id])
  memberships          SupportTeamMembership[]
  pauseSlots           SupportPauseSlot[]
  kpiEntries           SupportKpiEntry[]
  campaigns            SupportCampaign[]
  scheduleRuleVersions SupportScheduleRuleVersion[]
  shiftPatternVersions SupportShiftPatternVersion[]
  shiftAssignments     SupportShiftAssignment[]
  shiftOccurrences     SupportShiftOccurrence[]
  shiftOffers          SupportShiftOffer[]
  extraShiftSlots      SupportExtraShiftSlot[]
  extraShiftClaims     SupportExtraShiftClaim[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model SupportTeamMembership {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String
  userId         String
  validFrom      DateTime
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  team         SupportTeam  @relation(fields: [teamId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([teamId, userId, validFrom])
  @@index([organizationId, validFrom, validTo])
  @@index([userId, validFrom, validTo])
}

model SupportScheduleRuleVersion {
  id                          String    @id @default(cuid())
  organizationId              String
  teamId                      String
  version                     Int
  timezone                    String    @default("America/Sao_Paulo")
  maxDailyMinutes             Int       @default(840)
  maxWeeklyMinutes            Int       @default(3600)
  minimumRestMinutes          Int       @default(600)
  minimumNoticeMinutes        Int       @default(60)
  maxMonthlyExchanges         Int       @default(8)
  autoApproveEligibleSwaps    Boolean   @default(true)
  requireManagerExtraApproval Boolean   @default(true)
  active                      Boolean   @default(true)
  effectiveFrom               DateTime
  effectiveTo                 DateTime?
  createdById                 String
  createdAt                   DateTime  @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id])
  team         SupportTeam              @relation(fields: [teamId], references: [id])
  createdBy    User                     @relation("SupportScheduleRuleCreator", fields: [createdById], references: [id])
  occurrences  SupportShiftOccurrence[]
  offers       SupportShiftOffer[]
  extraSlots   SupportExtraShiftSlot[]

  @@unique([teamId, version])
  @@index([organizationId, effectiveFrom, effectiveTo])
  @@index([teamId, active, effectiveFrom])
}

model SupportShiftPatternVersion {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String
  name           String
  version        Int
  startMinute    Int
  endMinute      Int
  weekdaysJson   String    @default("[1,2,3,4,5,6,0]")
  timezone       String    @default("America/Sao_Paulo")
  active         Boolean   @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id])
  team         SupportTeam              @relation(fields: [teamId], references: [id])
  createdBy    User                     @relation("SupportShiftPatternCreator", fields: [createdById], references: [id])
  assignments  SupportShiftAssignment[]
  occurrences  SupportShiftOccurrence[]

  @@unique([teamId, name, version])
  @@index([organizationId, active])
  @@index([teamId, effectiveFrom, effectiveTo])
}

model SupportShiftAssignment {
  id               String    @id @default(cuid())
  organizationId   String
  teamId           String
  userId           String
  patternVersionId String
  validFrom        DateTime
  validTo          DateTime?
  active           Boolean   @default(true)
  createdById      String
  updatedById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id])
  team           SupportTeam                @relation(fields: [teamId], references: [id])
  user           User                       @relation("SupportShiftAssignmentUser", fields: [userId], references: [id])
  patternVersion SupportShiftPatternVersion @relation(fields: [patternVersionId], references: [id])
  createdBy      User                       @relation("SupportShiftAssignmentCreator", fields: [createdById], references: [id])
  updatedBy      User                       @relation("SupportShiftAssignmentUpdater", fields: [updatedById], references: [id])
  occurrences    SupportShiftOccurrence[]

  @@index([organizationId, userId, validFrom, validTo])
  @@index([teamId, active, validFrom])
  @@index([patternVersionId])
}

model SupportShiftOccurrence {
  id                 String    @id @default(cuid())
  organizationId     String
  teamId             String
  userId             String
  assignmentId       String?
  patternVersionId   String?
  ruleVersionId      String
  localDate          String
  startsAt           DateTime
  endsAt             DateTime
  kind               String    @default("REGULAR")
  status             String    @default("PUBLISHED")
  sourceType         String    @default("MATERIALIZED")
  sourceId           String?
  ruleSnapshotJson   String
  publishedAt        DateTime  @default(now())
  cancelledAt        DateTime?
  cancellationReason String?
  createdById        String
  updatedById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization   Organization                @relation(fields: [organizationId], references: [id])
  team           SupportTeam                 @relation(fields: [teamId], references: [id])
  user           User                        @relation("SupportShiftOccurrenceUser", fields: [userId], references: [id])
  assignment     SupportShiftAssignment?     @relation(fields: [assignmentId], references: [id])
  patternVersion SupportShiftPatternVersion? @relation(fields: [patternVersionId], references: [id])
  ruleVersion    SupportScheduleRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  createdBy      User                        @relation("SupportShiftOccurrenceCreator", fields: [createdById], references: [id])
  updatedBy      User                        @relation("SupportShiftOccurrenceUpdater", fields: [updatedById], references: [id])
  pauseBookings  SupportPauseBooking[]
  offersCreated  SupportShiftOffer[]         @relation("SupportShiftOfferOccurrence")
  offersTargeted SupportShiftOffer[]         @relation("SupportShiftOfferTargetOccurrence")
  extraClaims    SupportExtraShiftClaim[]

  @@unique([assignmentId, localDate])
  @@index([organizationId, localDate, status])
  @@index([teamId, startsAt, endsAt])
  @@index([userId, startsAt, endsAt])
}

model SupportShiftOffer {
  id                 String    @id @default(cuid())
  organizationId     String
  teamId             String
  occurrenceId       String
  targetOccurrenceId String?
  offeredById        String
  targetUserId       String?
  ruleVersionId      String
  type               String    @default("SWAP")
  status             String    @default("OPEN")
  note               String?
  policySnapshotJson String
  expiresAt          DateTime?
  peerAcceptedAt     DateTime?
  decidedById        String?
  decidedAt          DateTime?
  decisionReason     String?
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id])
  team             SupportTeam                @relation(fields: [teamId], references: [id])
  occurrence       SupportShiftOccurrence     @relation("SupportShiftOfferOccurrence", fields: [occurrenceId], references: [id])
  targetOccurrence SupportShiftOccurrence?    @relation("SupportShiftOfferTargetOccurrence", fields: [targetOccurrenceId], references: [id])
  offeredBy        User                       @relation("SupportShiftOfferCreator", fields: [offeredById], references: [id])
  targetUser       User?                      @relation("SupportShiftOfferTargetUser", fields: [targetUserId], references: [id])
  ruleVersion      SupportScheduleRuleVersion @relation(fields: [ruleVersionId], references: [id])
  decidedBy        User?                      @relation("SupportShiftOfferDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status, expiresAt])
  @@index([teamId, status])
  @@index([offeredById, status])
  @@index([targetUserId, status])
}

model SupportExtraShiftSlot {
  id                 String   @id @default(cuid())
  organizationId     String
  teamId             String
  ruleVersionId      String
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int      @default(1)
  status             String   @default("OPEN")
  note               String?
  policySnapshotJson String
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id])
  team         SupportTeam                @relation(fields: [teamId], references: [id])
  ruleVersion  SupportScheduleRuleVersion @relation(fields: [ruleVersionId], references: [id])
  createdBy    User                       @relation("SupportExtraShiftSlotCreator", fields: [createdById], references: [id])
  claims       SupportExtraShiftClaim[]

  @@unique([teamId, startsAt, endsAt])
  @@index([organizationId, status, startsAt])
}

model SupportExtraShiftClaim {
