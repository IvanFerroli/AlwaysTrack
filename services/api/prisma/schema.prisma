  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([provider])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  metadataJson   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
}

model ServiceCase {
  id              String    @id @default(cuid())
  organizationId  String
  createdByUserId String
  status          String    @default("NEW")
  primarySourceId String?   @unique
  summary         String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("ServiceCaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  primarySource ServiceCaseSource?  @relation("ServiceCasePrimarySource", fields: [primarySourceId], references: [id], onDelete: Restrict)
  sources       ServiceCaseSource[] @relation("ServiceCaseSources")
  connectorRuns ConnectorRun[]
  evidenceFacts EvidenceFact[]
  conflicts     EvidenceConflict[]

  @@index([organizationId, status])
  @@index([organizationId, createdByUserId, createdAt])
  @@index([createdByUserId])
  @@index([updatedAt])
}

model ServiceCaseSource {
  id              String   @id @default(cuid())
  organizationId  String
  caseId          String
  kind            String
  sourceReference String
  sourceUrl       String?
  observedAt      DateTime
  metadataJson    String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCase  ServiceCase  @relation("ServiceCaseSources", fields: [caseId], references: [id], onDelete: Restrict)
  primaryFor   ServiceCase? @relation("ServiceCasePrimarySource")

  @@unique([caseId, kind, sourceReference])
  @@index([organizationId, observedAt])
  @@index([caseId, observedAt])
}

model CompanionInstallation {
  id                  String    @id @default(cuid())
  organizationId      String
  userId              String
  browserProfileId    String
  extensionInstanceId String
  credentialHash      String
  credentialExpiresAt DateTime?
  status              String    @default("ACTIVE")
  pairedAt            DateTime  @default(now())
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User                   @relation("CompanionInstallationUser", fields: [userId], references: [id], onDelete: Restrict)
  connectorRuns ConnectorRun[]
  healthEvents  ConnectorHealthEvent[]

  @@unique([organizationId, browserProfileId])
  @@unique([extensionInstanceId])
  @@index([organizationId, userId, status])
  @@index([userId])
  @@index([credentialHash])
  @@index([lastSeenAt])
}

model ConnectorDefinition {
  id                   String    @id @default(cuid())
  organizationId       String
  connectorId          String
  displayName          String
  version              String
  selectorVersion      String?
  riskLevel            String
  domainsJson          String
  capabilitiesJson     String
  forbiddenActionsJson String
  searchKeysJson       String
  extractedFieldsJson  String
  enabled              Boolean   @default(true)
  lastValidatedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectorRuns ConnectorRun[]
  healthEvents  ConnectorHealthEvent[]

  @@unique([organizationId, connectorId])
  @@index([organizationId, enabled])
  @@index([connectorId])
  @@index([lastValidatedAt])
}

model ConnectorRun {
  id                    String    @id @default(cuid())
  organizationId        String
  caseId                String
  connectorDefinitionId String
  installationId        String
  userId                String
  browserProfileId      String
  status                String    @default("QUEUED")
  wave                  Int?
  warningsJson          String?
  diagnosticsJson       String?
  interventionCode      String?
  failureMessage        String?
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCase         ServiceCase           @relation(fields: [caseId], references: [id], onDelete: Restrict)
  connectorDefinition ConnectorDefinition   @relation(fields: [connectorDefinitionId], references: [id], onDelete: Restrict)
  installation        CompanionInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  user                User                  @relation("ConnectorRunUser", fields: [userId], references: [id], onDelete: Restrict)
  evidenceFacts       EvidenceFact[]

  @@index([organizationId, status])
  @@index([caseId, startedAt])
  @@index([connectorDefinitionId, startedAt])
  @@index([installationId, startedAt])
  @@index([userId])
  @@index([browserProfileId])
}

model EvidenceFact {
  id                  String   @id @default(cuid())
  organizationId      String
  caseId              String
  connectorRunId      String?
  key                 String
  valueJson           String
  normalizedValueJson String
  sourceSystem        String
  sourceReference     String?
  observedAt          DateTime
  collectedAt         DateTime @default(now())
  confidence          Float
  freshness           String
  sensitivity         String
  acquisition         String
  ruleId              String?
  createdAt           DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCase  ServiceCase        @relation(fields: [caseId], references: [id], onDelete: Restrict)
  connectorRun ConnectorRun?      @relation(fields: [connectorRunId], references: [id], onDelete: Restrict)
  chosenBy     EvidenceConflict[] @relation("EvidenceConflictChosenFact")

  @@index([organizationId, key])
  @@index([caseId, key, observedAt])
  @@index([connectorRunId])
  @@index([sourceSystem, sourceReference])
  @@index([sensitivity])
}

model EvidenceConflict {
  id               String    @id @default(cuid())
  organizationId   String
  caseId           String
  key              String
  factIdsJson      String
  status           String    @default("OPEN")
  chosenFactId     String?
  resolutionReason String?
  resolvedByKind   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceCase  ServiceCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  chosenFact   EvidenceFact? @relation("EvidenceConflictChosenFact", fields: [chosenFactId], references: [id], onDelete: Restrict)
  resolvedBy   User?         @relation("EvidenceConflictResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([caseId, key, status])
  @@index([chosenFactId])
  @@index([resolvedByUserId])
}

model ConnectorHealthEvent {
  id                    String   @id @default(cuid())
  organizationId        String
  connectorDefinitionId String
  installationId        String?
  state                 String
  connectorVersion      String
  selectorVersion       String?
  eventCode             String?
  diagnosticsJson       String?
  checkedAt             DateTime
  createdAt             DateTime @default(now())

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectorDefinition ConnectorDefinition    @relation(fields: [connectorDefinitionId], references: [id], onDelete: Restrict)
  installation        CompanionInstallation? @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@index([organizationId, checkedAt])
  @@index([connectorDefinitionId, checkedAt])
  @@index([installationId, checkedAt])
  @@index([state, checkedAt])
}
